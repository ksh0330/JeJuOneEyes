{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local analysis catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "datasets", "joins"],
  "properties": {
    "schema_version": { "const": 1 },
    "datasets": { "type": "array", "items": { "$ref": "#/$defs/dataset" } },
    "joins": { "type": "array", "items": { "$ref": "#/$defs/join" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "key": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_kind", "reference", "adapter", "region_scheme", "native_time_grain", "columns", "metrics"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["hub_public_file", "center_local_file", "official_public_file"] },
        "reference": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "adapter": { "$ref": "#/$defs/id" },
        "region_scheme": { "$ref": "#/$defs/id" },
        "region_label": { "type": "string", "minLength": 1 },
        "native_time_grain": { "enum": ["hour", "day", "month"] },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_month", "end_month"],
          "properties": {
            "start_month": { "$ref": "#/$defs/month" },
            "end_month": { "$ref": "#/$defs/month" }
          }
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value_column", "unit", "grain", "aggregation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "value_column": { "$ref": "#/$defs/id" },
        "unit": { "type": "string", "minLength": 1 },
        "grain": { "$ref": "#/$defs/key" },
        "aggregation": { "enum": ["sum", "dedupe_equal_then_sum", "select_total"] },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_dataset", "right_dataset", "left_on", "right_on", "cardinality", "status", "evidence"],
      "properties": {
        "left_dataset": { "$ref": "#/$defs/id" },
        "right_dataset": { "$ref": "#/$defs/id" },
        "left_on": { "$ref": "#/$defs/key" },
        "right_on": { "$ref": "#/$defs/key" },
        "cardinality": { "enum": ["one_to_one", "many_to_one", "one_to_many"] },
        "status": { "enum": ["candidate", "verified"] },
        "evidence": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "verified" } } },
      "then": { "properties": { "evidence": { "minLength": 1 } } }
    }
  }
}
