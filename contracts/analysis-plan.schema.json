{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "period", "region_ids", "industry_ids", "metrics", "group_by", "exclude_months"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": { "enum": ["compare", "trend"] },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_month", "end_month"],
      "properties": {
        "start_month": { "$ref": "#/$defs/month" },
        "end_month": { "$ref": "#/$defs/month" }
      }
    },
    "region_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "industry_ids": {
      "type": "array",
      "description": "Empty means all supported industries.",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "group_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["region", "month"] }
    },
    "exclude_months": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 12 }
    }
  },
  "$defs": {
    "month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
  }
}
